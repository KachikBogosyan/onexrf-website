# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# images
# Stray asset files anywhere in the repo are ignored...
/images/
*.jpg
*.jpeg
*.png
*.gif
*.webp
*.bmp
*.ico
*.svg
# ...but public/ IS the site's asset directory and has to ship. Without this
# the build succeeds on Vercel and every product photo 404s at runtime.
!public/**
public/**/.DS_Store

notes.txt